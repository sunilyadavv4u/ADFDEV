				"type": "string"
			},
			"processstepid": {
				"type": "string",
				"defaultValue": "0"
			},
			"StepRunType": {
				"type": "string",
				"defaultValue": "0"
			},
			"JobtreePipelineRunID": {
				"type": "string"
			},
			"isSLARun": {
				"type": "string"
			}
		},
		"variables": {
			"ErrorVar": {
				"type": "Boolean"
			}
		},
		"folder": {
