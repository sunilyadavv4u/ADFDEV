											"value": "{\n\"Job\":\"@{activity('GetEmailConfig').output.firstRow.notificationName}\",\n\"Environment\":\"@{activity('GetEmailConfig').output.firstRow.Environment}\",\n\"ToList\":\"@{activity('GetEmailConfig').output.firstRow.toID}\",\n\"CCList\":\"@{activity('GetEmailConfig').output.firstRow.ccID}\",\n\"SubjectLine\":\"@{activity('GetEmailConfig').output.firstRow.Subject}\",\n\"DataFactory\":\"@{pipeline().DataFactory}\",\n\"Pipeline\":\"@{pipeline().parameters.PipelineName}\",\n\"Activity\":\"Test Activity\",\n\"Error\":\"@{replace(pipeline().parameters.ErrorMessage,'\\','\\\\')}\",\n\"Process\":\"ADF\",\n\"ObjectName\":\"@{pipeline().parameters.ObjectName}\",\n\"ado_AreaPath\":\"@{activity('GetEmailConfig').output.firstRow.ado_AreaPath}\",\n\"ado_AssignedTo\":\"@{activity('GetEmailConfig').output.firstRow.ado_AssignedTo}\",\n\"ado_IterationPath\":\"@{activity('GetEmailConfig').output.firstRow.ado_IterationPath}\",\n\"ado_Priority\":\"@{activity('GetEmailConfig').output.firstRow.ado_Priority}\",\n\"ado_Tags\":\"@{activity('GetEmailConfig').output.firstRow.ado_Tags}\",\n\"ado_State\":\"@{activity('GetEmailConfig').output.firstRow.ado_State}\",\n\"JobId\":\"@{pipeline().parameters.JobId}\",\n\"ProcessStepId\":\"@{pipeline().parameters.ProcessStepId}\",\n\"ProcessStepName\":\"@{activity('GetEmailConfig').output.firstRow.ProcessStepName}\",\n\"JobTreeId\":\"@{activity('GetEmailConfig').output.firstRow.JobTreeId}\",\n\"JobName\":\"@{activity('GetEmailConfig').output.firstRow.JobName}\",\n\"TrackName\":\"@{activity('GetEmailConfig').output.firstRow.trackName}\",\n\"ado_IsEnabled\":\"@{activity('GetEmailConfig').output.firstRow.ado_IsEnabled}\",\n\"ado_WorkItemType\":\"NA\",\n\"ado_Url\":\"NA\",\n\"ProcessType\":\"@{activity('GetEmailConfig').output.firstRow.ProcessType}\",\n\"ProcessId\":\"@{activity('GetEmailConfig').output.firstRow.SubProcessId}\",\n\"JobRunId\":\"@{activity('GetEmailConfig').output.firstRow.JobRunId}\"\n}",
