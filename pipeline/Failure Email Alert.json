					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "IF '@{replace(pipeline().parameters.DQStatus,'''','')}' = 'Exception: Validation Failed'\nselect 'count' = 'default'\nELSE\nIF EXISTS (select 1 from metadata.tbl_Notification with (NOLOCK) where Jobid=@{pipeline().parameters.JobId}  and ado_IsEnabled=0)\nselect 'Count'= 'ado_disabled'\nElse\nIF Exists(SELECT * from logging.tbl_Notification_current \nwhere  JobId = @{pipeline().parameters.JobId}  and ado_WorkItemType='Alert')\nselect 'Count'='ado_enabled_task'\nELSE\nselect 'Count'='ado_enabled_alert'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_OrchConfig",
						"type": "DatasetReference"
					}
				}
